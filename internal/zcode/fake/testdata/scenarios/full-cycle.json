{
  "name": "full-cycle",
  "on_request": [
    {
      "method": "provider/updateAccountConfig",
      "reply": {"result": {"receivedRevision": "account-bridge:corpus-fix1", "providerCount": 0, "status": "received"}}
    },
    {
      "method": "provider/refreshRegistry",
      "reply": {"result": {"refreshed": true}},
      "side_effects": [
        {
          "emit": {
            "method": "state.updated",
            "params": {"scope": "registry", "reason": "registry_refresh", "revision": 2,
                       "patch": {"providers": {"zai-api": {"models": ["GLM-5.3-Flash", "GLM-5.3"]}}}}
          }
        }
      ]
    },
    {
      "method": "session/create",
      "reply": {"result": {"session": {"sessionId": "sess_fix1"}, "protocol": {"name": "ZCode Protocol", "version": 1}}},
      "side_effects": [
        {
          "emit": {
            "method": "session/lifecycle/changed",
            "params": {"sessionId": "sess_fix1", "state": "starting", "generation": 1, "revision": 1, "lastError": null}
          }
        },
        {
          "reverse": {
            "method": "session/requestRuntimePreferences",
            "params": {"sessionId": "sess_fix1", "scope": "runtime-materialization"},
            "timeout_ms": 15000,
            "expect_answer": {"result": {"nativeSearchEnhancementsEnabled": false, "memoryEnabled": false}}
          }
        },
        {
          "emit": {
            "method": "session/lifecycle/changed",
            "params": {"sessionId": "sess_fix1", "state": "ready", "generation": 1, "revision": 2, "lastError": null}
          }
        }
      ]
    },
    {
      "method": "session/subscribe",
      "reply": {"result": {"sessionId": "sess_fix1", "eventSeq": 0, "events": []}}
    },
    {
      "method": "session/setModel",
      "reply": {"result": {}}
    },
    {
      "method": "session/send",
      "times": 1,
      "reply": {"result": {"accepted": true, "sessionId": "sess_fix1", "stateRevision": 1}},
      "side_effects": [
        {
          "emit": {
            "method": "state.updated",
            "params": {"patch": {"status": "running"}, "reason": "prompt_started", "revision": 1, "scope": "session", "sessionId": "sess_fix1", "type": "state.updated"}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "turn.started", "seq": 1, "turnId": "turn_fix1", "deliveryKind": "desktop-continuous"}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 2, "turnId": "turn_fix1", "payload": {"kind": "scheduled", "toolCallId": "tc1", "toolName": "Edit", "description": "Edit main.go", "input": {"file_path": "src/main.go", "old_string": "old body", "new_string": "new body"}}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 3, "turnId": "turn_fix1", "payload": {"kind": "started", "toolCallId": "tc1", "startedAt": "2026-01-01T00:00:00Z"}}
          }
        },
        {
          "reverse": {
            "method": "interaction/requestPermission",
            "params": {"requestId": "perm-1", "sessionId": "sess_fix1", "turnId": "turn_fix1",
                       "toolCallId": "tc1", "toolName": "Bash", "reason": "run echo",
                       "riskLevel": "medium", "input": {"command": "echo hi"},
                       "options": [
                         {"optionId": "allow_once", "kind": "allow_once", "name": "Allow once",
                          "response": {"decision": "allow", "reason": "Approved once"}},
                         {"optionId": "deny", "kind": "deny", "name": "Deny",
                          "response": {"decision": "deny", "reason": "denied"}}
                       ]},
            "timeout_ms": 500,
            "reannounce": {"count": 2, "interval_ms": 40},
            "expect_answer": {"result": {"decision": "allow", "reason": "Approved once"}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 4, "turnId": "turn_fix1", "payload": {"kind": "progress", "toolCallId": "tc1", "elapsedMs": 12, "stdoutTail": "tail-bytes"}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 5, "turnId": "turn_fix1", "payload": {"kind": "result", "toolCallId": "tc1", "result": {"ok": true, "display": {"kind": "diff"}}, "duration": 15}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "part.delta", "seq": 6, "turnId": "turn_fix1", "messageId": "msg_1", "partId": "part_1", "field": "text", "delta": "done text"}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "turn.completed", "seq": 7, "turnId": "turn_fix1", "deliveryKind": "desktop-continuous"}
          }
        }
      ]
    },
    {
      "method": "session/resume",
      "reply": {
        "result": {"session": {"sessionId": "sess_fix1"}, "protocol": {"name": "ZCode Protocol", "version": 1}}
      }
    },
    {
      "method": "session/close",
      "reply": {"result": {"closed": true}}
    }
  ],
  "unknown_method": {"error": {"code": -32601, "message": "MethodNotFound"}},
  "eof_drain_ms": 100
}
