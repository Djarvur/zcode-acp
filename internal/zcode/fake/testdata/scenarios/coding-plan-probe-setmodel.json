{
  "name": "coding-plan-probe-setmodel",
  "on_request": [
    {
      "method": "provider/updateAccountConfig",
      "reply": {
        "result": {
          "receivedRevision": "account-bridge:cp-fix1",
          "providerCount": 1,
          "status": "received"
        }
      }
    },
    {
      "method": "provider/refreshRegistry",
      "reply": {
        "result": {
          "refreshed": true
        }
      }
    },
    {
      "method": "session/create",
      "reply": {
        "result": {
          "session": {
            "sessionId": "sess_cp1"
          },
          "protocol": {
            "name": "ZCode Protocol",
            "version": 1
          },
          "settings": {
            "model": {
              "available": [
                {
                  "ref": {
                    "providerId": "zai-api",
                    "modelId": "GLM-5.3-Flash"
                  }
                }
              ]
            }
          }
        }
      },
      "side_effects": [
        {
          "emit": {
            "method": "session/lifecycle/changed",
            "params": {
              "sessionId": "sess_cp1",
              "state": "starting",
              "generation": 1,
              "revision": 1,
              "lastError": null
            }
          }
        },
        {
          "emit": {
            "method": "session/lifecycle/changed",
            "params": {
              "sessionId": "sess_cp1",
              "state": "ready",
              "generation": 1,
              "revision": 2,
              "lastError": null
            }
          }
        }
      ]
    },
    {
      "method": "session/setModel",
      "reply": {
        "result": {
          "session": {
            "sessionId": "sess_cp1"
          },
          "settings": {
            "model": {
              "current": {
                "providerId": "account:zai-individual-coding-plan",
                "modelId": "GLM-5.3-Flash"
              },
              "available": [
                {
                  "ref": {
                    "providerId": "account:zai-individual-coding-plan",
                    "modelId": "GLM-5.3"
                  }
                },
                {
                  "ref": {
                    "providerId": "account:zai-individual-coding-plan",
                    "modelId": "GLM-5.3-Flash"
                  }
                }
              ]
            }
          }
        }
      },
      "side_effects": [
        {
          "reverse": {
            "method": "interaction/requestProviderRuntimeHeaders",
            "params": {
              "requestId": "cp-probe-hdr-1",
              "sessionId": "sess_cp1",
              "workspace": {
                "workspacePath": "/tmp/happy-turn-ws"
              },
              "modelSelection": {
                "providerId": "account:zai-individual-coding-plan",
                "modelId": "GLM-5.3-Flash"
              },
              "providerId": "zhipu-account",
              "reason": "model-request"
            },
            "timeout_ms": 15000,
            "expect_answer": {
              "result": {
                "headersApplied": true,
                "requestAuth": {
                  "apiKey": "zc-synthetic-pat-a-corpus-fixture",
                  "apiKeyId": "key_pat_corpus_a",
                  "accountScope": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                }
              }
            }
          }
        },
        {
          "emit": {
            "method": "state.updated",
            "params": {
              "scope": "registry",
              "reason": "registry_refresh",
              "revision": 3,
              "patch": {
                "providers": {
                  "account:zai-individual-coding-plan": {
                    "models": [
                      "GLM-5.3",
                      "GLM-5.3-Flash"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "method": "session/close",
      "reply": {
        "result": {
          "closed": true
        }
      }
    }
  ],
  "eof_drain_ms": 100
}
