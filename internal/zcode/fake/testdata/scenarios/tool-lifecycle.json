{
  "name": "tool-lifecycle",
  "on_request": [
    {
      "method": "session/create",
      "reply": {"result": {"session": {"sessionId": "sess_fix1"}, "protocol": {"name": "ZCode Protocol", "version": 1}}},
      "side_effects": [
        {
          "emit": {
            "method": "session/lifecycle/changed",
            "params": {"sessionId": "sess_fix1", "state": "starting", "generation": 1, "revision": 1, "lastError": null}
          }
        },
        {
          "reverse": {
            "method": "session/requestRuntimePreferences",
            "params": {"sessionId": "sess_fix1", "scope": "runtime-materialization"},
            "timeout_ms": 15000,
            "expect_answer": {"result": {"nativeSearchEnhancementsEnabled": false, "memoryEnabled": false}}
          }
        },
        {
          "emit": {
            "method": "session/lifecycle/changed",
            "params": {"sessionId": "sess_fix1", "state": "ready", "generation": 1, "revision": 2, "lastError": null}
          }
        }
      ]
    },
    {
      "method": "session/subscribe",
      "reply": {"result": {"sessionId": "sess_fix1", "eventSeq": 0, "events": []}}
    },
    {
      "method": "session/setModel",
      "reply": {"result": {}}
    },
    {
      "method": "session/send",
      "times": 1,
      "reply": {"result": {"accepted": true, "sessionId": "sess_fix1", "stateRevision": 1}},
      "side_effects": [
        {
          "emit": {
            "method": "state.updated",
            "params": {"patch": {"status": "running"}, "reason": "prompt_started", "revision": 1, "scope": "session", "sessionId": "sess_fix1", "type": "state.updated"}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "turn.started", "seq": 1, "turnId": "turn_fix1", "deliveryKind": "desktop-continuous"}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 2, "turnId": "turn_fix1", "payload": {"kind": "scheduled", "toolCallId": "tc1", "toolName": "Edit", "description": "Edit main.go", "input": {"file_path": "src/main.go", "old_string": "old body", "new_string": "new body"}}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 3, "turnId": "turn_fix1", "payload": {"kind": "started", "toolCallId": "tc1", "startedAt": "2026-01-01T00:00:00Z"}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 4, "turnId": "turn_fix1", "payload": {"kind": "progress", "toolCallId": "tc1", "elapsedMs": 12, "stdoutTail": "tail-bytes"}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 5, "turnId": "turn_fix1", "payload": {"kind": "batch", "toolCallIds": ["tcA", "tcB"], "successCount": 2, "errorCount": 0}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 6, "turnId": "turn_fix1", "payload": {"kind": "scheduled", "toolCallId": "tc-child", "toolName": "Read", "source": "subagent", "input": {"file_path": "child.txt"}}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 7, "turnId": "turn_fix1", "payload": {"kind": "result", "toolCallId": "tc1", "result": {"ok": true, "display": {"kind": "diff"}}, "duration": 15}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "part.delta", "seq": 8, "turnId": "turn_fix1", "messageId": "msg_1", "partId": "part_1", "field": "text", "delta": "done text"}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "part.delta", "seq": 9, "turnId": "turn_other", "messageId": "msg_x", "partId": "part_x", "field": "text", "delta": "FOREIGN"}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "turn.completed", "seq": 10, "turnId": "turn_fix1", "deliveryKind": "desktop-continuous"}
          }
        }
      ]
    },
    {
      "method": "session/send",
      "reply": {"result": {"accepted": true, "sessionId": "sess_fix1", "stateRevision": 2}},
      "side_effects": [
        {
          "emit": {
            "method": "state.updated",
            "params": {"patch": {"status": "running"}, "reason": "prompt_started", "revision": 2, "scope": "session", "sessionId": "sess_fix1", "type": "state.updated"}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "turn.started", "seq": 11, "turnId": "turn_fix1", "deliveryKind": "desktop-continuous"}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 12, "turnId": "turn_fix1", "payload": {"kind": "scheduled", "toolCallId": "tc2", "toolName": "Write", "description": "Write new.go", "input": {"file_path": "docs/new.md", "content": "file body"}}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 13, "turnId": "turn_fix1", "payload": {"kind": "started", "toolCallId": "tc2", "startedAt": "2026-01-01T00:00:01Z"}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "tool.updated", "seq": 14, "turnId": "turn_fix1", "payload": {"kind": "result", "toolCallId": "tc2", "result": {"ok": true}, "duration": 5}}
          }
        },
        {
          "emit": {
            "method": "session/event",
            "params": {"type": "turn.completed", "seq": 15, "turnId": "turn_fix1", "deliveryKind": "desktop-continuous"}
          }
        }
      ]
    }
  ],
  "unknown_method": {"error": {"code": -32601, "message": "MethodNotFound"}},
  "eof_drain_ms": 100
}
