{
  "name": "lingering-latch-32010",
  "on_request": [
    {
      "method": "session/create",
      "reply": {
        "result": {"session": {"sessionId": "sess_fix1"}, "protocol": {"name": "ZCode Protocol", "version": 1}}
      },
      "side_effects": [
        {
          "emit": {
            "method": "session/lifecycle/changed",
            "params": {"sessionId": "sess_fix1", "state": "starting", "generation": 1, "revision": 1, "lastError": null}
          }
        },
        {
          "reverse": {
            "method": "session/requestRuntimePreferences",
            "params": {"sessionId": "sess_fix1", "scope": "runtime-materialization"},
            "timeout_ms": 15000,
            "expect_answer": {"result": {"nativeSearchEnhancementsEnabled": false, "memoryEnabled": false}}
          }
        },
        {
          "emit": {
            "method": "session/lifecycle/changed",
            "params": {"sessionId": "sess_fix1", "state": "ready", "generation": 1, "revision": 2, "lastError": null}
          }
        }
      ]
    },
    {
      "method": "session/subscribe",
      "reply": {
        "result": {"sessionId": "sess_fix1", "eventSeq": 0, "events": []}
      }
    },
    {
      "method": "session/setModel",
      "reply": {"result": {}}
    },
    {
      "method": "session/send",
      "times": 1,
      "latch_ms": 2000,
      "reply": {"result": {"accepted": true, "sessionId": "sess_fix1", "stateRevision": 1}},
      "side_effects": [
        {
          "emit": {
            "method": "state.updated",
            "params": {"patch": {"status": "running"}, "reason": "prompt_started", "revision": 1, "scope": "session", "sessionId": "sess_fix1", "type": "state.updated"}
          }
        },
        {
          "emit": {
            "method": "state.updated",
            "params": {"patch": {"status": "idle"}, "reason": "prompt_completed", "revision": 2, "scope": "session", "sessionId": "sess_fix1", "type": "state.updated"}
          }
        }
      ]
    },
    {
      "method": "session/send",
      "reply": {"result": {"accepted": true, "sessionId": "sess_fix1", "stateRevision": 3}},
      "side_effects": [
        {
          "emit": {
            "method": "state.updated",
            "params": {"patch": {"status": "running"}, "reason": "prompt_started", "revision": 3, "scope": "session", "sessionId": "sess_fix1", "type": "state.updated"}
          }
        },
        {
          "emit": {
            "method": "state.updated",
            "params": {"patch": {"status": "idle"}, "reason": "prompt_completed", "revision": 4, "scope": "session", "sessionId": "sess_fix1", "type": "state.updated"}
          }
        }
      ]
    }
  ],
  "latch_refusal": {"error": {"code": -32010, "message": "A prompt is already running for this session"}},
  "unknown_method": {"error": {"code": -32601, "message": "MethodNotFound"}},
  "eof_drain_ms": 100
}
